#!/usr/bin/env php
<?php

declare(strict_types=1);

// Reads a password through Prompter on a real terminal (stdin is a pty).

use KaririCode\Console\Input\ArrayInput;
use KaririCode\Console\Output\StreamOutput;
use KaririCode\Console\Prompt\Prompter;

require dirname(__DIR__, 3) . '/vendor/autoload.php';

$before = trim((string) shell_exec('stty -g'));
$secret = (new Prompter(new ArrayInput(interactive: true), new StreamOutput(STDOUT)))->password('Token')->value;
$after  = trim((string) shell_exec('stty -g'));

echo "\nlength=" . strlen($secret) . ' restored=' . ($before === $after && $before !== '' ? 'yes' : 'no') . "\n";
