{
    "name": "kariricode/console",
    "description": "KaririCode Console — terminal command framework (ARFA 1.3 L1, Spec V4.3.3)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "console",
        "cli",
        "command",
        "kariricode",
        "arfa"
    ],
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "kariricode/contract": "^2.12",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-pcntl": "Delivers SIGINT/SIGTERM/SIGHUP to Signalable commands (SignalMiddleware)",
        "ext-posix": "Re-raises declined signals so the process ends by that signal",
        "ext-tokenizer": "Required by AttributeCommandLoader to discover #[AsCommand] classes"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Console\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "kcode run phpstan analyse --memory-limit=768M --no-progress",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "complexity": "@php tools/complexity.php src",
        "test": "kcode test",
        "test-conformance": "kcode test --testsuite Conformance",
        "infection": "kcode run infection --threads=max --only-covering-test-cases --no-progress",
        "psalm": "kcode run psalm --no-progress",
        "security": [
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php",
            "kcode test --group security"
        ],
        "sbom": "@php tools/sbom.php",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@security"
        ]
    },
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "spec": "4.3.3"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
